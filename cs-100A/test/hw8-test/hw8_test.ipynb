   "metadata": {},
   "outputs": [],
   "source": [
    "screen = t.Screen()\n",
    "SIZE = 15\n",
    "# click handler\n",
    "def print_xy(x, y):  # x and y as coordinates of click\n",
    "    print(str(x) + \", \" + str(y))\n",
    "\n",
    "s = t.getscreen()\n",
    "s.onclick(print_xy)  # call print_xy function for click\n"
   ]
  }
